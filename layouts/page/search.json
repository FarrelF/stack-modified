{{- $pages := partial "helper/pages.html" .Site.Home -}}
{{- $result := slice -}}
{{- $ImageURL := "" -}}
{{- $formatConfig := partial "helper/image-processing-config.html" . -}}
{{- $searchWidth := $formatConfig.searchWidth -}}
{{- $searchHeight := $formatConfig.searchHeight -}}

{{- range $pages -}}
    {{- $data := dict
        "title" .Title
        "date" .Date
        "permalink" .RelPermalink
        "content" (.Plain)
        "section" .Section
        "tags" (partial "helper/terms.html" (dict "Page" . "Taxonomy" "tags"))
        "categories" (partial "helper/terms.html" (dict "Page" . "Taxonomy" "categories"))
        "description" (partial "data/description" .)
    -}}

    {{- $image := partial "helper/image" (dict "Image" .Params.image "Resources" .Resources "Context" .) -}}
    {{- if $image -}}
        {{- $searchAnchor := .Params.imageAnchor | default $formatConfig.searchAnchor -}}
        {{- $searchMode := lower (.Params.imageMode | default "") -}}
        {{- $searchOp := "Fill" -}}
        {{- if in (slice "fit" "height") $searchMode -}}{{- $searchOp = "Fit" -}}{{- end -}}
        {{- if $.Page.Site.Params.CDN.Images.URL -}}
            {{- $ImageURL = $.Page.Site.Params.CDN.Images.URL -}}
        {{- end -}}
        {{- $imagePermalink := "" -}}
        {{- with $image.Resource -}}
            {{- if reflect.IsImageResourceProcessable . -}}
                {{- $best := .Fill (printf "%dx%d %s" $searchWidth $searchHeight $searchAnchor) -}}
                {{- if eq $searchOp "Fit" -}}
                    {{- $best = .Fit (printf "%dx%d" $searchWidth $searchHeight) -}}
                {{- end -}}
                {{- $subType := .MediaType.SubType -}}
                {{- if and $formatConfig.webpEnabled (ne $subType "webp") -}}
                    {{- $webp := .Fill (printf "%dx%d %s webp q%d" $searchWidth $searchHeight $searchAnchor $formatConfig.webpQuality) -}}
                    {{- if eq $searchOp "Fit" -}}
                        {{- $webp = .Fit (printf "%dx%d webp q%d" $searchWidth $searchHeight $formatConfig.webpQuality) -}}
                    {{- end -}}
                    {{- if lt (len $webp.Content) (len $best.Content) -}}
                        {{- $best = $webp -}}
                    {{- end -}}
                {{- end -}}
                {{- if and $formatConfig.avifEnabled (ne $subType "avif") (ne $subType "gif") -}}
                    {{- $avif := .Fill (printf "%dx%d %s avif q%d" $searchWidth $searchHeight $searchAnchor $formatConfig.avifQuality) -}}
                    {{- if eq $searchOp "Fit" -}}
                        {{- $avif = .Fit (printf "%dx%d avif q%d" $searchWidth $searchHeight $formatConfig.avifQuality) -}}
                    {{- end -}}
                    {{- if lt (len $avif.Content) (len $best.Content) -}}
                        {{- $best = $avif -}}
                    {{- end -}}
                {{- end -}}
                {{- $imagePermalink = $best.Permalink -}}
                {{- if and $ImageURL (eq hugo.IsProduction true) -}}
                    {{- $imagePermalink = printf "%s%s" $ImageURL $best.RelPermalink -}}
                {{- end -}}
            {{- else -}}
                {{- $imagePermalink = .RelPermalink | absURL -}}
            {{- end -}}
        {{- else -}}
            {{- $imagePermalink = $image.Permalink | absURL -}}
        {{- end -}}
        {{- $data = merge $data (dict "image" $imagePermalink) -}}
    {{- end -}}

    {{- $result = $result | append $data -}}
{{- end -}}

{{ jsonify $result }}
