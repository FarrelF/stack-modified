{{- $pages := partial "helper/pages.html" .Site.Home -}}
{{- $result := slice -}}
{{- $ImageURL := "" -}}

{{- range $pages -}}
    {{- $data := dict "title" .Title "date" .Date "permalink" .RelPermalink "content" (.Plain) -}}

    {{- $image := partial "helper/image" (dict "Image" .Params.image "Resources" .Resources "Context" .) -}}
    {{- if $image -}}
        {{- if $.Page.Site.Params.CDN.Images.URL -}}
            {{- $ImageURL = $.Page.Site.Params.CDN.Images.URL -}}
        {{- end -}}
        {{- $imagePermalink := "" -}}
        {{- if (default true $.Page.Site.Params.imageProcessing.cover.enabled) -}}
            {{- $thumbnail := $image.Resource.Fill "120x120" -}}
            {{- $imagePermalink = $thumbnail.Permalink -}}
            {{- if eq hugo.IsProduction true -}}
                {{- $imagePermalink = printf "%s%s" $ImageURL $thumbnail.RelPermalink -}}
            {{- end -}}
        {{- else -}}
            {{- $imagePermalink = $image.Permalink -}}
        {{- end -}}
        {{- $data = merge $data (dict "image" $imagePermalink) -}}
    {{- end -}}

    {{- $result = $result | append $data -}}
{{- end -}}

{{ jsonify $result }}
